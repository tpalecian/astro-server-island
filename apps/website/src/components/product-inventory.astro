---
const { sku = "default" } = Astro.props;

// Set cache headers for Bunny CDN - Inventory data changes frequently, cache for 1 minute
// Include SKU in cache key to ensure different products are cached separately
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=60");

// Generate consistent inventory based on SKU (deterministic but different per product)
const hashSKU = (str: string) => {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    const char = str.charCodeAt(i);
    hash = (hash << 5) - hash + char;
    hash = hash | 0; // Convert to 32bit integer
  }
  return Math.abs(hash);
};

// Calculate inventory outside Promise to ensure determinism
const inventorySeed = hashSKU(sku);
const stockCount = inventorySeed % 51;

// Simulate checking inventory from warehouse system
const inventory: number = await new Promise((resolve) => {
  setTimeout(() => {
    resolve(stockCount);
  }, 1500); // Medium loading - inventory checks can be slower
});

const isInStock = inventory > 0;
const stockStatus = isInStock ? "In Stock" : "Out of Stock";
const stockText = isInStock
  ? `${inventory} available`
  : "Currently unavailable";
---

<div class="flex flex-col">
    <span class={`font-semibold ${isInStock ? 'text-green-600' : 'text-red-600'}`}>
        {stockStatus}
    </span>
    <span class="text-sm text-gray-600">
        {stockText}
    </span>
</div>
