---
// Set cache headers for Bunny CDN - Server time changes frequently, cache for 30 seconds
Astro.response.headers.set("Cache-Control", "public, max-age=30");

const date = new Date();

// Add a lazy loading await for the time
const time = await new Promise((resolve) => {
  setTimeout(() => {
    resolve(date.toLocaleTimeString());
  }, 2000);
});
---

<p>The time on the server is {time}</p>