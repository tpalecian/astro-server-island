---
import { getCategoryBySlug, getCategoryCards } from '@rotate/cms'

import { isSiteCategory, siteCategoryToCardsSlug } from '@/lib'
import { categoryCardsToListItems } from '@/lib/dato'

import BaseLayout from '@/layouts/base-layout.astro'

export const prerender = false

const token = import.meta.env.DATOCMS_API_KEY ?? ''
const categoryParam = Astro.params.category ?? ''
const getterOptions = { token }

if (!isSiteCategory(categoryParam)) {
	return Astro.rewrite('/404')
}

const categoryData = await getCategoryBySlug(categoryParam, getterOptions)

if (!categoryData) {
	return Astro.rewrite('/404')
}

const cardsPayload = await getCategoryCards(siteCategoryToCardsSlug(categoryParam), getterOptions)
const listItems = categoryCardsToListItems(categoryParam, cardsPayload)

const heading = categoryData.filterText ?? categoryParam
const pageTitle = `${heading} | Category`
---

<BaseLayout title={pageTitle} headerStyle="default">
	<main
		class="[margin-inline:auto] w-full max-w-[var(--breakpoint-maxwidth)] px-[var(--grid-default-margin)] py-800"
	>
		<h1 class="title-style1-700 text-content-default-primary mb-300">{heading}</h1>
		<p class="body-style1-400 text-content-default-secondary mb-500">
			{listItems.length}
			{listItems.length === 1 ? 'item' : 'items'}
		</p>
		<ul class="flex flex-col gap-200">
			{
				listItems.map((item) => (
					<li>
						<a
							href={item.href}
							class="link link-underline title-style1-300 text-content-default-primary"
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>
