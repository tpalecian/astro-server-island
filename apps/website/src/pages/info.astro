---
import { getInfo } from '@rotate/cms'

import BaseLayout from '@/layouts/base-layout.astro'

export const prerender = false

const token = import.meta.env.DATOCMS_API_KEY ?? ''
const info = await getInfo({ token })

if (!info) {
	return Astro.rewrite('/404')
}

const heading = info.title?.trim() || 'Info'
const pageTitle = `${heading} | Info`
---

<BaseLayout title={pageTitle} headerStyle="default">
	<main
		class="[margin-inline:auto] w-full max-w-[var(--breakpoint-maxwidth)] px-[var(--grid-default-margin)] py-800"
	>
		<article>
			<h1 class="title-style1-700 text-content-default-primary mb-300">{heading}</h1>
			<p class="body-style1-400 text-content-default-secondary">
				Slug: {info.slug ?? '—'} — content blocks (ticket F).
			</p>
		</article>
	</main>
</BaseLayout>
