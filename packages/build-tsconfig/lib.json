{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Library",
	"extends": "./base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist"
	},
	"exclude": ["dist", "node_modules"]
}
