{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Tools",
	"extends": "./base.json",
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"noFallthroughCasesInSwitch": true,
		"resolveJsonModule": true,
		"noEmit": true
	},
	"exclude": ["node_modules"]
}
