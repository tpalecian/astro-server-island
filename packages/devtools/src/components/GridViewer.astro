<div class="grid-viewer fixed inset-0 z-[9999] pointer-events-none">
	<input type="checkbox" id="grid-toggle" class="peer sr-only" aria-label="Toggle grid overlay" />
	<div class="absolute bottom-0 right-0 flex gap-2 p-2 pointer-events-auto">
		<label
			for="grid-toggle"
			class="px-2 py-1 text-xs cursor-pointer rounded bg-[var(--color-background-default-primary)] text-[var(--color-content-default-primary)] border border-[var(--color-content-default-primary)]"
		>
			Toggle Grid
		</label>
		<button
			type="button"
			class="px-2 py-1 text-xs cursor-pointer rounded bg-[var(--color-background-default-primary)] text-[var(--color-content-default-primary)] border border-[var(--color-content-default-primary)]"
		>
			Toggle Fluid
		</button>
	</div>
	<div
		class="absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-150 ease-out peer-checked:opacity-100 peer-checked:[&_.border-line]:scale-y-100"
		aria-hidden="true"
	>
		<div
			class="grid grid-cols-12 min-h-screen gap-x-[var(--grid-default-gutter)] px-[var(--grid-default-margin)]"
		>
			{
				Array.from({ length: 12 }).map((_, i) => (
					<div class="relative">
						<div class="absolute w-px left-0 top-0 h-full scale-y-0 origin-top border-line bg-[var(--color-border-default-primary)] transition-transform duration-150 ease-out" />
						<div class="absolute w-px right-0 top-0 h-full scale-y-0 origin-top border-line bg-[var(--color-border-default-primary)] transition-transform duration-150 ease-out" />
					</div>
				))
			}
		</div>
	</div>
</div>
