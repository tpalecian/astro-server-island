<div class="grid-viewer pointer-events-none fixed inset-0 z-[9999]">
	<input type="checkbox" id="grid-toggle" class="peer sr-only" aria-label="Toggle grid overlay" />
	<div class="pointer-events-auto absolute right-0 bottom-0 flex gap-100 p-100">
		<label
			for="grid-toggle"
			class="body-style1-300 rounded-radius-primary-smallest bg-background-default-primary text-content-default-primary border-content-default-primary cursor-pointer border px-100 py-75"
		>
			Toggle Grid
		</label>
		<button
			type="button"
			class="body-style1-300 rounded-radius-primary-smallest bg-background-default-primary text-content-default-primary border-content-default-primary cursor-pointer border px-100 py-75"
		>
			Toggle Fluid
		</button>
	</div>
	<div
		class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-150 ease-out peer-checked:opacity-100 peer-checked:[&_.border-line]:scale-y-100"
		aria-hidden="true"
	>
		<div
			class="grid min-h-screen grid-cols-12 gap-x-[var(--grid-default-gutter)] px-[var(--grid-default-margin)]"
		>
			{
				Array.from({ length: 12 }).map((_, i) => (
					<div class="relative">
						<div class="border-line bg-border-default-primary absolute top-0 left-0 h-full w-px origin-top scale-y-0 transition-transform duration-150 ease-out" />
						<div class="border-line bg-border-default-primary absolute top-0 right-0 h-full w-px origin-top scale-y-0 transition-transform duration-150 ease-out" />
					</div>
				))
			}
		</div>
	</div>
</div>
