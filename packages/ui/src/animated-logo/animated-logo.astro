---
/**
 * Brand logo with scroll-based swap and hover bounce.
 * At top: R + otate + ° (full "Rotate°"). When scrolled: R + ° (R°).
 * Animations via Motion (vanilla). Styling via Tailwind.
 */
interface Props {
	href?: string
	/** When true, shows R° variant (e.g. on category landing pages) */
	compact?: boolean
	class?: string
}

const { href = '/', compact = false, class: className } = Astro.props
---

<a
	href={href}
	class:list={[
		'group text-content-default-primary -ml-200 flex items-center gap-50 p-200 no-underline',
		'hover:animate-logo-bounce',
		'motion-reduce:hover:animate-none',
		className,
	]}
	data-logo
	data-compact={compact}
	data-scrolled={compact ? 'true' : 'false'}
	aria-label="Back to home"
>
	<!-- R -->
	<svg
		class="tablet:h-[26px] tablet:w-[18px] h-5 w-[14px] shrink-0"
		viewBox="0 0 18 26"
		fill="currentColor"
		aria-hidden="true"
	>
		<path
			d="M0.500252 25.5L0.500252 0.5L9.39442 0.5C11.538 0.5 13.362 1.13958 14.8475 2.39992C16.333 3.66027 17.0851 5.37208 17.0851 7.51655C17.0851 9.60459 16.2954 11.2788 14.7159 12.5767C13.1552 13.8935 11.2936 14.5331 9.14997 14.5331L17.6117 24.804V25.4812H13.5312L4.7875 14.5331H4.11057L4.11057 25.5H0.500252V25.5ZM4.09177 11.1095H9.56365C10.6355 11.1095 11.5568 10.7709 12.3466 10.1125C13.1176 9.4541 13.5124 8.58879 13.5124 7.51655C13.5124 6.44432 13.1176 5.57901 12.3466 4.92062C11.5757 4.26223 10.6543 3.92363 9.56365 3.92363L4.09177 3.92363L4.09177 11.1095Z"
		></path>
	</svg>
	<!-- otate + degree — Motion animates letters and degree -->
	<span class="relative flex items-center">
		<svg
			data-otate
			class="logo-otate tablet:h-[26px] tablet:w-[76px] h-5 w-[58px] transition-opacity duration-200 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-data-[compact=true]:pointer-events-none group-data-[compact=true]:absolute group-data-[compact=true]:opacity-0 group-data-[scrolled=true]:pointer-events-none group-data-[scrolled=true]:absolute"
			viewBox="0 0 76 26"
			fill="currentColor"
