---
interface Props {
	name?: string | null
	info?: string | null
}

const { name, info } = Astro.props
---

<blockquote class="flex flex-col gap-300 border-border-default-secondary border-l-200 pl-400">
	{
		name ? (
			<p class="title-style1-400 text-content-default-primary">{name}</p>
		) : null
	}
	{info ? <p class="body-style1-400 text-content-default-secondary">{info}</p> : null}
	<div class="longform-style1-500 text-content-default-primary [&_a]:link [&_a]:link-underline">
		<slot name="body" />
	</div>
</blockquote>
