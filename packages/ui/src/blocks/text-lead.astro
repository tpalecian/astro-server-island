---
interface Props {
	pretitle?: string | null
	size?: string | null
}

const { pretitle, size } = Astro.props
---

<section class="flex flex-col gap-300" data-text-lead-size={size ?? undefined}>
	{
		pretitle ? (
			<p class="body-style1-400 text-content-default-secondary tracking-wide uppercase">
				{pretitle}
			</p>
		) : null
	}
	<div class="longform-style1-500 text-content-default-primary [&_a]:link [&_a]:link-underline">
		<slot name="body" />
	</div>
</section>
