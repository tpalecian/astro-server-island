---
import AnimatedLogo from '@rotate/ui/animated-logo/animated-logo.astro'

interface Props {
	primaryLink?: { text: string; href: string } | null
	iconLink?: { href: string; ariaLabel: string } | null
	compactLogo?: boolean
	style?: 'default' | 'overlay'
}

const { primaryLink, iconLink, compactLogo = false, style = 'default' } = Astro.props as Props
---

<header
	class:list={[
		'sticky top-0 z-10 w-full',
		{ 'bg-background-default-primary-lightest': style === 'default' },
	]}
>
	<div
		class:list={[
			'flex items-center justify-between',
			'tablet:h-1000 h-700',
			'px-[var(--grid-default-margin)]',
			'[margin-inline:auto] w-full max-w-[var(--breakpoint-maxwidth)]',
		]}
	>
		<div class="shrink-0">
			<AnimatedLogo compact={compactLogo} />
		</div>

		<nav class="flex items-center gap-300">
			{
				primaryLink && (
					<a
						href={primaryLink.href}
						class:list={[
							'btn btn-primary btn-size-100 btn-press title-style1-200',
							'tablet:inline-flex hidden',
						]}
					>
						{primaryLink.text}
					</a>
				)
			}
			{
				iconLink && (
					<a
						href={iconLink.href}
						class:list={[
							'btn btn-primary btn-icon btn-icon-padded btn-press',
							'tablet:inline-flex hidden',
						]}
						aria-label={iconLink.ariaLabel}
						data-icon-size="100"
					>
						<svg viewBox="0 0 2 12" class="icon" aria-hidden="true" fill="currentColor">
							<path d="M0.36 11.436H1.688V4.06803H0.36V11.436ZM1 2.32403C1.48 2.32403 1.88 1.92403 1.88 1.44403C1.88 0.964026 1.48 0.564026 1 0.564026C0.52 0.564026 0.12 0.964026 0.12 1.44403C0.12 1.92403 0.52 2.32403 1 2.32403Z" />
						</svg>
					</a>
				)
			}
			<button
				type="button"
				class:list={[
					'inline-flex items-center justify-center',
					'size-[var(--icon-dimension-width)]',
					'text-content-default-primary',
					'tablet:hidden',
				]}
				aria-label="Open menu"
				aria-expanded="false"
				data-header-menu-toggle
				data-icon-size="200"
			>
				<svg viewBox="0 0 20 20" class="icon" aria-hidden="true" fill="currentColor">
					<rect y="3" width="20" height="2" rx="1"></rect>
					<rect y="9" width="20" height="2" rx="1"></rect>
					<rect y="15" width="20" height="2" rx="1"></rect>
				</svg>
			</button>
		</nav>
	</div>
</header>
