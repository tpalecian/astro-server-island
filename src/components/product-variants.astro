---
const { sku = 'default' } = Astro.props;

type Variant = {
    color: string;
    size: string;
    sku: string;
};

// Set cache headers for Bunny CDN - Product variants don't change often, cache for 10 minutes
// Include SKU in cache key to ensure different products are cached separately
Astro.response.headers.set('Cache-Control', `public, max-age=600, s-maxage=600`);

// Generate consistent variants based on SKU (deterministic but different per product)
const hashSKU = (str: string) => {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
        const char = str.charCodeAt(i);
        hash = ((hash << 5) - hash) + char;
        hash = hash | 0; // Convert to 32bit integer
    }
    return Math.abs(hash);
};

// Calculate variants outside Promise to ensure determinism
const colors = ['Black', 'White', 'Navy', 'Gray', 'Red', 'Blue', 'Green'];
const sizes = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];

const seed = hashSKU(sku);
const numVariants = 3 + (seed % 8); // 3-10 variants

// Product-specific color sets based on SKU
const productColors: Record<string, string[]> = {
    'example-1': ['Black', 'White', 'Navy', 'Gray'],
    'example-2': ['Black', 'Silver', 'Rose Gold', 'Blue'],
    'example-3': ['Black', 'White', 'RGB', 'Gray', 'Pink']
};

const availableColors = productColors[sku] || colors;
const generatedVariants: Variant[] = [];

for (let i = 0; i < numVariants; i++) {
    const variantSeed = (seed + i * 17) % 1000;
    generatedVariants.push({
        color: availableColors[variantSeed % availableColors.length],
        size: sizes[variantSeed % sizes.length],
        sku: `VAR-${sku.toUpperCase().slice(0, 3)}-${String(variantSeed).padStart(4, '0')}`
    });
}

// Simulate fetching product variants from catalog system
const variants: Variant[] = await new Promise((resolve) => {
    setTimeout(() => {
        resolve(generatedVariants);
    }, 3000); // Slow loading - variants data can be complex to fetch
});
---

<div class="space-y-3">
    <h3 class="font-semibold text-lg text-gray-900">Available Variants</h3>
    <div class="grid grid-cols-1 gap-2">
        {variants.slice(0, 5).map((variant, index) => (
            <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg border border-gray-200">
                <div class="flex flex-col">
                    <span class="font-medium text-gray-900">{variant.color}</span>
                    <span class="text-sm text-gray-600">Size: {variant.size}</span>
                </div>
                <span class="text-xs text-gray-500 font-mono">{variant.sku}</span>
            </div>
        ))}
    </div>
    <p class="text-sm text-gray-600">{variants.length} variants available</p>
</div>
