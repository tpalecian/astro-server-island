---
import { cva } from "class-variance-authority";

const serverIslandWrapper = cva("flex flex-col w-full relative rounded-lg border-2 border-dashed p-5", {
  variants: {
    color: {
      fastServerIsland: ["border-green-300"],
      slowServerIsland: ["border-yellow-300"],
      verySlowServerIsland: ["border-red-300"],
    },
  },
  defaultVariants: {
    color: "fastServerIsland",
  },
});


const { color, cacheTime, cacheDescription } = Astro.props;
---

<div class={serverIslandWrapper({ color })}>
    <!-- Cache Info Badge -->
    <div class="absolute -top-2.5 left-4 bg-white px-2.5 py-1 rounded-md border border-gray-200 text-xs font-medium text-gray-600">
        <span class="text-gray-400">Cache:</span> <span class="text-gray-700">{cacheTime}</span>
    </div>

    <!-- Content -->
    <div>
        <slot />
    </div>
</div>